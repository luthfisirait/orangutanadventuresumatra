GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACES_REVIEW_DISPLAY_LIMIT=3
GOOGLE_PLACES_REVIEW_MIN_TEXT_LENGTH=45
GOOGLE_PLACES_REVIEW_MAX_TEXT_LENGTH=340
GOOGLE_PLACES_REVIEWS_SORT=most_relevant
