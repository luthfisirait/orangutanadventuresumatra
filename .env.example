GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACES_REVIEW_DISPLAY_LIMIT=3
GOOGLE_PLACES_REVIEW_MIN_TEXT_LENGTH=45
GOOGLE_PLACES_REVIEW_MAX_TEXT_LENGTH=340
GOOGLE_PLACES_REVIEWS_SORT=most_relevant
GOOGLE_PLACES_REVIEWS_CACHE_SECONDS=86400

# Zoho Mail SMTP:
# - smtppro.zoho.com for paid organization/domain accounts
# - smtp.zoho.com for free/personal accounts
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@orangutanadventuresumatra.com
SMTP_PASS=
BOOKING_EMAIL_TO=support@orangutanadventuresumatra.com
BOOKING_EMAIL_FROM=support@orangutanadventuresumatra.com

# PayPal checkout:
# Use NEXT_PUBLIC_PAYPAL_PAYMENT_MODE=manual for manual transfer instructions.
# Use NEXT_PUBLIC_PAYPAL_PAYMENT_MODE=checkout when REST checkout credentials are ready.
# Use sandbox while testing checkout, then switch PAYPAL_ENV / NEXT_PUBLIC_PAYPAL_ENV to live.
# NEXT_PUBLIC_PAYPAL_CLIENT_ID and PAYPAL_CLIENT_ID can use the same PayPal app client ID.
NEXT_PUBLIC_PAYPAL_PAYMENT_MODE=manual
NEXT_PUBLIC_PAYPAL_MANUAL_EMAIL=Saipolvalley01@gmail.com
NEXT_PUBLIC_PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_CURRENCY=EUR
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
